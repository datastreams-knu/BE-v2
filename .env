# .env.example
# 실제 값은 .env 파일에 채우고, .env는 절대 커밋 금지

# ===========================================
# PostgreSQL
# ===========================================
POSTGRES_DB=knu_chatbot
POSTGRES_USER=app
POSTGRES_PASSWORD=

# ===========================================
# Redis
# ===========================================
# 로컬에서는 docker network 내부 호스트명 사용
REDIS_HOST=redis
REDIS_PORT=6379

# ===========================================
# BE 서버
# ===========================================
# Database
DATABASE_URL=postgresql+asyncpg://app:CHANGE_ME@postgres:5432/knu_chatbot

# Redis (ADR-007: 캐시 DB 0, Pub/Sub DB 1)
REDIS_CACHE_URL=redis://redis:6379/0
REDIS_PUBSUB_URL=redis://redis:6379/1

# JWT (ADR-005)
JWT_SECRET_KEY=
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=14

# Google OAuth (ADR-005)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# AI 서버 (BE → AI 호출용)
AI_SERVER_URL=http://ai:8001

# 로깅 (ADR-012)
LOG_LEVEL=INFO

# ===========================================
# AI 서버
# ===========================================
PINECONE_API_KEY=
PINECONE_INDEX_NAME=info
UPSTAGE_API_KEY=